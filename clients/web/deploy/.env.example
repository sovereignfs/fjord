# Copy to `.env` (next to the compose files) and edit. Keep it out of version control: it holds secrets.
# Every variable is described in clients/web/README.md.

# --- The address people use ---------------------------------------------------------------------------------------
# https, except on localhost. Passkeys, emailed links and the Sovereign redirect address are made from it.
FJORD_URL=http://localhost:3000
# The port on this machine that a reverse proxy sends to (the container always listens on 3000).
# FJORD_PORT=3000

# --- Signing in: at least one way must be on to use the app -------------------------------------------------------
FJORD_AUTH_LOCAL=1
# 32 characters or more:  openssl rand -base64 48
FJORD_AUTH_SECRET=
# `closed`: the first account only. `open`: anyone who can reach the page.
FJORD_AUTH_SIGNUP=closed

# Sovereign sign-in (optional; all three together):
# FJORD_AUTH_SOVEREIGN_ISSUER=https://auth.sovereign.example.com/api/auth
# FJORD_AUTH_SOVEREIGN_CLIENT_ID=
# FJORD_AUTH_SOVEREIGN_CLIENT_SECRET=

# --- Repository tokens at rest -------------------------------------------------------------------------------------
# Without this, a repository cannot be connected. Make it once and keep it with your secrets, apart from the database
# backups: a lost key means connecting the repositories again.   openssl rand -base64 32
FJORD_ENCRYPTION_KEY=

# --- Email (optional): with it, addresses are verified and a password can be reset -----------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Fjord <fjord@example.com>

# --- PostgreSQL (only with compose.postgres.yaml) --------------------------------------------------------------------
# POSTGRES_PASSWORD=
