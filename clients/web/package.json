{
  "name": "fjord-web",
  "version": "0.0.0",
  "private": true,
  "description": "The hosted web client for Fjord: your documents as plain files in a Git repository you control.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "node scripts/db-generate.mjs",
    "boot-check": "node scripts/boot-check.mjs",
    "db:dev": "node scripts/dev-db.mjs",
    "e2e": "playwright test",
    "build:wasm": "bash ../../crates/fjord-wasm/build.sh",
    "build:editor": "pnpm --dir ../../packages/fjord-editor install --frozen-lockfile && pnpm --dir ../../packages/fjord-editor build"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "~1.7.12",
    "@better-auth/passkey": "~1.7.12",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@libsql/client": "^0.18.0",
    "@sovereignfs/ui": "0.83.1",
    "better-auth": "~1.7.12",
    "drizzle-orm": "^0.45.4",
    "fjord-editor": "link:../../packages/fjord-editor",
    "next": "^16.4.3",
    "nodemailer": "10.2.1",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^0.31.11",
    "jose": "6.2.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
