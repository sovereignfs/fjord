{
  "name": "fjord-web",
  "version": "0.5.0",
  "private": true,
  "description": "The hosted web client for Fjord: your documents as plain files in a Git repository you control.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start --port ${PORT:-3001}",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "db:generate": "node scripts/db-generate.mjs",
    "boot-check": "node scripts/boot-check.mjs",
    "db:dev": "node scripts/dev-db.mjs",
    "e2e": "playwright test",
    "manifest:check": "sovereign-manifest check",
    "build:wasm": "bash ../../crates/fjord-wasm/build.sh && node scripts/copy-wasm-web.mjs",
    "build:editor": "pnpm --dir ../../packages/fjord-editor install --frozen-lockfile && pnpm --dir ../../packages/fjord-editor build"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "~1.7.20",
    "@better-auth/passkey": "~1.7.20",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@libsql/client": "^0.18.0",
    "@sovereignfs/config": "0.1.0",
    "@sovereignfs/sdk": "2.1.0",
    "@sovereignfs/ui": "0.92.0",
    "better-auth": "~1.7.20",
    "drizzle-orm": "^0.45.4",
    "fjord-editor": "link:../../packages/fjord-editor",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm-strikethrough": "^2.0.1",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "next": "^16.4.6",
    "nodemailer": "10.5.0",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@sovereignfs/manifest": "0.1.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "jose": "6.2.17",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.0.5"
  }
}
