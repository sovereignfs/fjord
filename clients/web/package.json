{
  "name": "fjord-web",
  "version": "0.0.0",
  "private": true,
  "description": "The hosted web client for Fjord: your documents as plain files in a Git repository you control.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "node scripts/db-generate.mjs",
    "boot-check": "node scripts/boot-check.mjs",
    "db:dev": "node scripts/dev-db.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@libsql/client": "^0.18.0",
    "@sovereignfs/ui": "0.83.1",
    "drizzle-orm": "^0.45.4",
    "next": "^16.3.6",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
